{{!--
  The club header, spliced in above mdBook's own menu bar.

  The links point at the club website. They are written out here (the
  theme has no settings file), so if the website moves, change the three
  URLs that start with the website address, and the Discord invite.
--}}
<header class="nf-header">
  <div class="nf-row">
    <a class="nf-brand" href="{{ path_to_root }}index.html">
      <span class="nf-mark" aria-hidden="true"></span>
      <span class="nf-brand-text">
        <b>Minnesota Nanofabrication</b>
        <small>Documentation</small>
      </span>
    </a>
    <nav class="nf-links" aria-label="Club website">
      <a href="https://beastr45.github.io/nanofab_web_staging/">Website</a>
      <a href="https://beastr45.github.io/nanofab_web_staging/machines/">Machines</a>
      <a href="https://beastr45.github.io/nanofab_web_staging/events/">Events</a>
      <a class="nf-cta" href="https://discord.gg/G9T6bk84w" target="_blank" rel="noopener">Join<span class="nf-long">&nbsp;the club</span></a>
    </nav>
  </div>
  <div class="nf-progress" aria-hidden="true"><span id="nf-progress"></span></div>
</header>
