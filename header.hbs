      <span class="nf-brand-text">
        <b>Minnesota Nanofabrication</b>
        <small>Documentation</small>
      </span>
    </a>
    <nav class="nf-links" aria-label="Documentation">
      <a href="{{ path_to_root }}getting-started.html">Getting started</a>
      <a href="{{ path_to_root }}safety/safety.html">Safety</a>
      <a href="{{ path_to_root }}contributing.html">Contributing</a>
      <a class="nf-cta" href="https://beastr45.github.io/nanofab_web_staging/">Club website<span class="nf-ne" aria-hidden="true">&nbsp;↗</span></a>
    </nav>
  </div>
  <div class="nf-progress" aria-hidden="true"><span id="nf-progress"></span></div>
</header>
